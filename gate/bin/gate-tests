#!/usr/bin/env python3
"""gate-tests - rules on changes to test files, for a branch against its base.

Usage: gate-tests [--require-new-tests] [--base REF] [--spec FILE] [--dir DIR]
  exit 0 = rules hold, 1 = a rule failed (one line per violation, with how to fix it)

Rules:
  protected  an existing test file may be modified, deleted or renamed only when the spec (FILE) lists it, backticked,
             under `## Test changes`. Without a spec the list is empty. Adding test files is always fine.
  new tests  with --require-new-tests, source code added or modified without any test file added or modified fails.
"""
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
sys.dont_write_bytecode = True
from gate_branch import CODE_EXT, base_ref, changes, is_test  # noqa: E402


def allowed_changes(spec):
    """Paths listed under '## Test changes' (backticked), or an empty set."""
    if not spec or not spec.is_file():
        return set(), False
    text, cur, paths = spec.read_text(errors="replace"), None, set()
    for line in text.splitlines():
        m = re.match(r"^##\s+(.+?)\s*$", line)
        if m:
            cur = m.group(1)
        elif cur == "Test changes":
            paths.update(re.findall(r"`([^`\s]+)`", line))
    return {p.lstrip("./") for p in paths}, True


def main(argv):
    opts = {"--base": None, "--spec": None, "--dir": "."}
    need_tests, i = False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--require-new-tests":
            need_tests = True
        elif a in opts and i + 1 < len(argv):
            opts[a] = argv[i + 1]
            i += 1
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
        i += 1
    cwd = opts["--dir"]
    ch = changes(cwd, base_ref(cwd, opts["--base"]))
    allowed, have_spec = allowed_changes(Path(opts["--spec"]) if opts["--spec"] else None)
    bad = []
    for s, old, _ in ch:
        if s in "MDRT" and is_test(old) and old not in allowed:
            bad.append("existing test changed without authorisation: %s %s. HOW TO FIX: undo the change to this test; if the "
                       "required behaviour really replaces what it checks, say which test and why, so the spec can list it "
                       "under '## Test changes'%s" % (s, old, "" if have_spec else " (no spec was given)"))
    added_or_edited_tests = [n for s, o, n in ch if is_test(n) and s in "AM"]
    code = [n for s, o, n in ch if s in "AM" and not is_test(n) and Path(n).suffix in CODE_EXT]
    if need_tests and code and not added_or_edited_tests:
        bad.append("source code changed but no test was added or updated: %s. HOW TO FIX: add tests for the new behaviour "
                   "(new test files need no authorisation)." % ", ".join(code[:5]))
    if bad:
        print("FAILED: test rules")
        for b in bad:
            print("  - " + b)
        return 1
    print("ok: test rules")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
